{
  "name": "aman-first-birthday",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.ts",
    "deploy": "node scripts/deploy.ts",
    "local": "node scripts/local.ts",
    "local:stop": "supabase stop",
    "local:psql": "docker exec -it supabase_db_invite-project psql -U postgres",
    "local:share": "node scripts/local.ts --share"
  },
  "dependencies": {
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^3.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
